# URL publique du site (SEO, sitemap, RSS, liens des e-mails de réinitialisation)
# Facultatif en production (le site utilise https://www.alaingnassoumari.com par défaut). Ne JAMAIS y mettre l'adresse *.vercel.app.
NEXT_PUBLIC_SITE_URL=https://www.alaingnassoumari.com
# Facultatif : code de vérification Google Search Console (méthode « balise HTML »)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clé secrète : côté serveur uniquement, ne jamais l'exposer ni la committer
SUPABASE_SECRET_KEY=sb_secret_...

# Adresses e-mail autorisées à accéder à /admin (séparées par des virgules)
ADMIN_EMAILS=docteur@exemple.com

# Formulaire de contact : envoi direct dans la boîte mail du Docteur (https://resend.com)
RESEND_API_KEY=re_...
# Expéditeur (facultatif). Sans domaine vérifié chez Resend : laisser vide (onboarding@resend.dev)
CONTACT_FROM=
