# URL publique du site (SEO, sitemap, RSS, liens des e-mails de réinitialisation)
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.com

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clé secrète : côté serveur uniquement, ne jamais l'exposer ni la committer
SUPABASE_SECRET_KEY=sb_secret_...

# Adresses e-mail autorisées à accéder à /admin (séparées par des virgules)
ADMIN_EMAILS=docteur@exemple.com
